// Thusa data model. Money is always integer cents. Every business-owned row carries businessId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
  READONLY
}

enum Language {
  en
  zu
  st
  tn
}

enum Province {
  EC
  FS
  GP
  KZN
  LP
  MP
  NC
  NW
  WC
}

enum Rhythm {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum CollectionStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
}

model Business {
  id                    String   @id @default(uuid())
  name                  String
  town                  String?
  province              Province
  ecdRegistrationNumber String?
  // Default language for messages to parents; each payer can override later.
  defaultLanguage       Language @default(en)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users           User[]
  auditLogs       AuditLog[]
  payers          Payer[]
  schedules       Schedule[]
  collections     Collection[]
  ledgerEntries   LedgerEntry[]
  balanceRequests BalanceRequest[]
  messages        Message[]
  aiSummaries     AiSummary[]
  payerInvites    PayerInvite[]
  consents        MessagingConsent[]
}

model User {
  id          String    @id @default(uuid())
  phoneE164   String    @unique
  name        String?
  role        Role      @default(OWNER)
  // Null until the owner completes onboarding.
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions Session[]

  @@index([businessId])
}

model OtpChallenge {
  id         String    @id
  phoneE164  String
  // HMAC-SHA256 of challengeId + code. The code itself is never stored.
  codeHash   String
  // HMAC of the client IP, for rate limiting without storing the raw IP.
  ipHash     String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, createdAt])
  @@index([ipHash, createdAt])
}

model Session {
  id        String    @id @default(uuid())
  // SHA-256 of the cookie token. The raw token only lives in the browser cookie.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A parent who pays the business. Never hard-deleted (collections and the ledger will point here);
// archive instead.
model Payer {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  parentName     String
  childName      String
  // AES-256-GCM, bound to businessId (src/lib/field-crypto.ts). Never store or log the plain number.
  phoneEncrypted String
  // Null means use the business's defaultLanguage.
  language       Language?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedule    Schedule?
  collections Collection[]
  // Set when the parent added themselves through an invite link.
  invite      PayerInvite?

  // Lets Schedule reference (id, businessId), so a schedule can't point at another business's payer.
  @@unique([id, businessId])
  @@index([businessId, archivedAt])
}

// How much a payer pays and when. One per payer; collections will copy the amount they request,
// so editing a schedule never rewrites history.
model Schedule {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  payerId     String
  payer       Payer    @relation(fields: [payerId, businessId], references: [id, businessId])
  // Per collection, in cents. CHECK > 0 in the migration.
  amountCents Int
  rhythm      Rhythm
  // WEEKLY/FORTNIGHTLY: ISO weekday, 1 = Monday … 7 = Sunday.
  // MONTHLY: day of month 1–31; shorter months use their last day. CHECKed in the migration.
  payday      Int
  // First day the schedule applies; fortnightly collections count from the first payday on or after it.
  startsOn    DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The FK pins businessId to the payer's, so this also means one schedule per payer.
  @@unique([payerId, businessId])
  @@index([businessId])
}

// One payment request to a payer for one due date. The amount and rhythm are copied from the schedule
// when the request is made, so editing a schedule never changes a request already sent.
// Status only becomes PAID from a verified provider event.
model Collection {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id])
  payerId           String
  payer             Payer            @relation(fields: [payerId, businessId], references: [id, businessId])
  dueDate           DateTime         @db.Date
  // CHECK > 0 in the migration.
  amountCents       Int
  // CHECK >= 0 in the migration.
  paidCents         Int              @default(0)
  rhythm            Rhythm
  status            CollectionStatus @default(PENDING)
  // Short, random and unique (e.g. THK7Q2M9XA): goes on the payer's statement and matches payments.
  reference         String           @unique
  // Sent with every provider call for this collection, so a retry can't create a second payment.
  idempotencyKey    String           @unique
  // "mock" or "stitch". Never a provider-specific type.
  provider          String
  // Null until the provider accepts the request.
  providerRequestId String?
  paymentUrl        String?
  // Set while a request is with the provider, so two clicks can't create two payment links.
  sendingSince      DateTime?
  requestedAt       DateTime?
  requestedByUserId String?
  // When the provider says the collection was paid in full. Null until then.
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ledgerEntries   LedgerEntry[]
  balanceRequests BalanceRequest[]
  messages        Message[]

  // One request per payer per due date.
  @@unique([payerId, dueDate])
  @@unique([provider, providerRequestId])
  // For the ledger to reference (id, businessId) later.
  @@unique([id, businessId])
  @@index([businessId, dueDate])
}

// A payment link for what is still owed on a part-paid collection. Payment links are fixed-amount, so the
// balance needs a link of its own; payments on it are credited to the same collection in the ledger.
// Like a collection, it has its own unique reference and idempotency key, and the amount is worked out
// on the server (amountCents − paidCents), never taken from a request.
model BalanceRequest {
  id                String     @id @default(uuid())
  businessId        String
  business          Business   @relation(fields: [businessId], references: [id])
  collectionId      String
  collection        Collection @relation(fields: [collectionId, businessId], references: [id, businessId])
  // The collection's paidCents when this was requested: one balance request per amount still owed,
  // so asking again returns the same link.
  forPaidCents      Int
  // CHECK > 0 in the migration.
  amountCents       Int
  reference         String     @unique
  idempotencyKey    String     @unique
  provider          String
  providerRequestId String?
  paymentUrl        String?
  sendingSince      DateTime?
  requestedAt       DateTime?
  requestedByUserId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([collectionId, forPaidCents])
  @@unique([provider, providerRequestId])
  @@index([businessId])
}

enum MessageKind {
  PAYMENT_REQUEST
  REMINDER
  BALANCE_REQUEST
}

enum MessageStatus {
  // Being sent right now.
  QUEUED
  SENT
  // Recorded but deliberately not delivered (demo account, or messaging not switched on).
  NOT_DELIVERED
  FAILED
}

// Every message to a parent: what it said and whether it went out. Shown to the owner on /messages.
// The phone is only stored masked (••••4567); the body is the rendered fixed template.
model Message {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id])
  collectionId      String
  collection        Collection    @relation(fields: [collectionId, businessId], references: [id, businessId])
  kind              MessageKind
  template          String
  language          Language
  channel           String
  phoneMasked       String
  body              String
  status            MessageStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  // Why it wasn't delivered, as a short code (e.g. demo_account, provider_refused). Never provider text.
  note              String?
  // Null when Thusa sent it on its own (the daily job).
  sentByUserId      String?
  // At most one message per key per business (e.g. one reminder per collection per day), so a retry or
  // a double click never messages a parent twice.
  dedupeKey         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([businessId, dedupeKey])
  @@index([businessId, createdAt])
  @@index([collectionId])
}

enum LedgerKind {
  PAYMENT
}

// Money that actually moved. Append-only: a trigger in the migration refuses UPDATE and DELETE, so a
// correction is a new entry. A collection's paidCents is the sum of its entries.
model LedgerEntry {
  id                String     @id @default(uuid())
  businessId        String
  business          Business   @relation(fields: [businessId], references: [id])
  collectionId      String
  collection        Collection @relation(fields: [collectionId, businessId], references: [id, businessId])
  kind              LedgerKind
  // Signed cents. Payments are positive (CHECKed in the migration).
  amountCents       Int
  provider          String
  // The provider's id for the payment, so one payment can never be credited twice.
  providerPaymentId String
  // When the provider says the money was paid.
  occurredAt        DateTime
  createdAt         DateTime   @default(now())

  @@unique([provider, providerPaymentId])
  @@index([collectionId])
  @@index([businessId, createdAt])
}

// Provider webhook deliveries we have processed, for dedupe. Written only once processing succeeds, so a
// replay of a delivery that failed still runs. No payload is kept (it can carry the payer's details).
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  // The delivery's id from the provider (Svix's svix-id for Stitch), the same on every retry.
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

enum AiSummaryStatus {
  PENDING
  OK
  FAILED
}

// One row per attempt at the AI's "This week in plain words" for a business, language and week. The
// dashboard reuses the latest OK row (24 h, or until a new payment); a PENDING row is a call in flight (it
// claims the attempt, so two page loads can't both call), and a FAILED one makes it wait 15 minutes. Every
// row counts towards the daily cap. text is the AI's answer after src/ai/summary.ts's checks, shown as plain
// text only. No prompt or other payment data is kept here.
model AiSummary {
  id            String          @id @default(uuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id])
  language      Language
  // First day of the week the summary covers (insightPeriod().start).
  periodStart   DateTime        @db.Date
  status        AiSummaryStatus
  text          String?
  // A short code (timeout, http_429, bad_number…). Never OpenAI's text.
  failureReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([businessId, createdAt])
  @@index([businessId, language, periodStart, createdAt])
}

enum InviteStatus {
  // The link is out; the parent hasn't used it yet.
  OPEN
  // The parent filled it in: "Awaiting approval". There is no Payer yet, so nothing can be sent to them.
  SUBMITTED
  // The owner approved: payerId is the parent it became.
  APPROVED
  // The owner turned the answers down. The parent's name and phone are cleared.
  DECLINED
  // Withdrawn before the parent used it.
  CANCELLED
}

// A single-use link a parent opens to add themselves (src/lib/invites.ts). The owner sets the child, the
// monthly fee and which rhythms the parent may choose; the parent gives their name, phone, rhythm, payday and
// language. Their answers wait here and only become a Payer with a Schedule when the owner approves, so no
// payment request or reminder can reach a parent who isn't approved. Expires 7 days after it was made.
model PayerInvite {
  id                 String            @id @default(uuid())
  businessId         String
  business           Business          @relation(fields: [businessId], references: [id])
  // SHA-256 of the link's secret, to find the invite from the link. Never logged.
  tokenHash          String            @unique
  // The secret itself, AES-256-GCM bound to businessId, so the owner can copy the link again.
  tokenEncrypted     String
  // The parent's cellphone, given by the owner. Uses the payer phone's encryption context, so approval copies
  // it to the Payer as it is. Cleared when the answers are declined, or the link is cancelled or expires unused.
  phoneEncrypted     String?
  childName          String
  // Per month, set by the owner. The weekly and fortnightly amounts are worked out from it on the server
  // (src/lib/fee-split.ts); the parent never sends an amount. CHECK > 0 in the migration.
  monthlyAmountCents Int
  // The rhythms the parent was offered (all three for now). At least one, CHECKed in the migration.
  allowedRhythms     Rhythm[]
  status             InviteStatus      @default(OPEN)
  expiresAt          DateTime
  createdByUserId    String?

  // The parent's answers, null until they submit. amountCents is per collection, from monthlyAmountCents and
  // rhythm: the migration CHECKs the sum, and that rhythm is one of allowedRhythms.
  parentName         String?
  language           Language?
  rhythm             Rhythm?
  payday             Int?
  amountCents        Int?
  submittedAt        DateTime?

  // The owner's approval, decline or cancel.
  decidedAt          DateTime?
  decidedByUserId    String?
  payerId            String?           @unique
  payer              Payer?            @relation(fields: [payerId], references: [id], onDelete: Restrict)
  consent            MessagingConsent?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Lets MessagingConsent reference (id, businessId), so a consent can't point at another business's invite.
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
}

// A parent's agreement to be messaged, ticked on the invite page: the exact words they agreed to, when, and
// which invite (and so which business and, once approved, which payer). Kept as evidence: a trigger in the
// migration refuses UPDATE and DELETE.
model MessagingConsent {
  id          String      @id @default(uuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id])
  inviteId    String      @unique
  invite      PayerInvite @relation(fields: [inviteId, businessId], references: [id, businessId])
  text        String
  consentedAt DateTime
  createdAt   DateTime    @default(now())

  // One consent per invite. inviteId is unique on its own too, so this is only for the foreign key.
  @@unique([inviteId, businessId])
  @@index([businessId])
}

// One row per request a public endpoint let through, for its rate limits (src/lib/rate-limit.ts). Only a
// keyed hash of what is counted (an IP, an invite link) is kept. The daily job deletes old rows.
model RateLimitHit {
  id        String   @id @default(uuid())
  bucket    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([bucket, keyHash, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String    @id @default(uuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  userId     String?
  action     String
  // Never put PII (phone numbers, account numbers, codes) in metadata.
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
}
