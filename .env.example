# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://thusa:thusa_local_only@localhost:5432/thusa
# Separate DB for integration tests (tests wipe it). Leave empty to skip them.
TEST_DATABASE_URL=postgresql://thusa:thusa_local_only@localhost:5432/thusa_test
SESSION_SECRET=change-me-32-random-bytes
# Encrypts payer phone numbers. 32 random bytes, base64. Losing or changing it makes stored numbers unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Payments: mock | stitch. Unset means mock in dev and tests; production refuses to send requests
# until it's set. mock accepts every request and moves no money (there's no payment page).
PAYMENTS_PROVIDER=mock

# Stitch Express (dashboard > Settings > Developers). Test credentials start with "test-".
# Viewing the secret in the dashboard REGENERATES it: the old one stops working at once.
STITCH_CLIENT_ID=test-00000000-0000-0000-0000-000000000000
STITCH_CLIENT_SECRET=test_client_secret
# Signing Secret of the webhook endpoint <PUBLIC_BASE_URL>/api/webhooks/payments (Stitch Express >
# Webhooks). Without it, Stitch webhooks are refused (503) and nothing is marked paid.
# Mock webhooks need no secret (derived from SESSION_SECRET) and are refused in production.
STITCH_WEBHOOK_SECRET=whsec_test_webhook_secret

# Public URL of this app (ngrok in dev, https://mythusa.vercel.app live), for the webhook in step 8.
# Payers aren't sent back to /pay/done yet: Express payment links 404 with a redirect_url parameter.
PUBLIC_BASE_URL=https://your-fixed-domain.ngrok-free.app

# Contact address on /terms and /privacy, where parents and owners send questions and requests (access,
# correction, deletion). Public, not a secret. In Vercel, set it only once a mailbox someone reads exists:
# while it's unset, the pages say the address isn't set up yet and point to the business instead.
CONTACT_EMAIL=privacy@example.com

# Messaging: Clickatell One API key (Clickatell portal > My SMS Setups > your One API setup). Empty in dev:
# messages go to /dev/outbox. Empty in production: messages to parents are recorded on /messages but not
# sent, and OTP login by SMS doesn't work (the demo login still does). In sandbox mode Clickatell only
# delivers to the test phones registered in its portal. The demo business's messages are never sent.
CLICKATELL_API_KEY=

# WhatsApp Cloud API (Meta). Set the token and the phone number id together, or neither. With them,
# payment requests, reminders and balance requests to English and isiZulu parents go by WhatsApp (approved
# templates only; Sesotho and Setswana stay on SMS), and the demo account offers "WhatsApp me".
# Token: a system user's permanent token (Business Settings > System users) with whatsapp_business_messaging
# and whatsapp_business_management. Phone number id: WhatsApp > API Setup (not the phone number itself).
# Business account id: only for /dev/whatsapp, which submits the templates to Meta for review.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Daily job (payment requests on payday, reminders): Vercel Cron calls /api/cron/daily with this as a
# bearer token. At least 16 characters. Unset: the job refuses to run.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=change-me-cron-secret-0000

# AI summary ("This week in plain words", docs/AI.md). Off unless AI_SUMMARY_ENABLED=true AND a key is set;
# otherwise the rule-based sentences show. When on, first names, badges and totals go to OpenAI (outside South
# Africa); never phones, surnames, children's names or references. Key: an OpenAI project key (server only,
# never NEXT_PUBLIC_). Model and effort are optional: gpt-5.6-luna and low (low | medium).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_SUMMARY_ENABLED=false
SENTRY_DSN=

# Judges' demo login (hackathon only). That one number always gets this code; no SMS is sent.
# Leave both empty to switch it off. Never use a real person's number.
DEMO_PHONE=0600000000
DEMO_OTP=123456
