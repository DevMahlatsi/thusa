# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://thusa:thusa_local_only@localhost:5432/thusa
# Separate DB for integration tests (tests wipe it). Leave empty to skip them.
TEST_DATABASE_URL=postgresql://thusa:thusa_local_only@localhost:5432/thusa_test
SESSION_SECRET=change-me-32-random-bytes
# Encrypts payer phone numbers. 32 random bytes, base64. Losing or changing it makes stored numbers unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Payments: mock | stitch. Unset means mock in dev and tests; production refuses to send requests
# until it's set. mock accepts every request and moves no money (there's no payment page).
PAYMENTS_PROVIDER=mock

# Stitch Express (dashboard > Settings > Developers). Test credentials start with "test-".
# Viewing the secret in the dashboard REGENERATES it: the old one stops working at once.
STITCH_CLIENT_ID=test-00000000-0000-0000-0000-000000000000
STITCH_CLIENT_SECRET=test_client_secret
# Signing Secret of the webhook endpoint <PUBLIC_BASE_URL>/api/webhooks/payments (Stitch Express >
# Webhooks). Without it, Stitch webhooks are refused (503) and nothing is marked paid.
# Mock webhooks need no secret (derived from SESSION_SECRET) and are refused in production.
STITCH_WEBHOOK_SECRET=whsec_dGVzdC13ZWJob29rLXNlY3JldC0yNGJ5

# Public URL of this app (ngrok in dev, https://mythusa.vercel.app live), for the webhook in step 8.
# Payers aren't sent back to /pay/done yet: Express payment links 404 with a redirect_url parameter.
PUBLIC_BASE_URL=https://your-fixed-domain.ngrok-free.app

# Messaging (leave empty in dev to log messages to console)
CLICKATELL_API_KEY=
SENTRY_DSN=

# Judges' demo login (hackathon only). That one number always gets this code; no SMS is sent.
# Leave both empty to switch it off. Never use a real person's number.
DEMO_PHONE=0600000000
DEMO_OTP=123456
